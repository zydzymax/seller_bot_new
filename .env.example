# SoVAni AI-продавец - Переменные окружения
# © SoVAni 2025
#
# Скопируйте этот файл в .env и заполните необходимые значения

# ====== ОСНОВНЫЕ НАСТРОЙКИ ======
APP_ENV=production
APP_VERSION=1.0.0

# ====== РЕЖИМ РАБОТЫ БОТА ======
# Выбор домена (режима):
#   - textile_manufacturing (швейная фабрика - default)
#   - ai_seller_self (продажа AI-ботов)
AI_SELLER_DOMAIN=textile_manufacturing

# ====== АДМИН-ДОСТУП ======
# ID администраторов (через запятую) для команд /result, /stats и т.д.
# Например: 12345,67890
ADMIN_CHAT_IDS=your_admin_chat_ids_here

# ====== API КЛЮЧИ ======
# Telegram Bot Token (обязательно)
TELEGRAM_TOKEN=your_telegram_token_here

# OpenAI API Key (обязательно)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (опционально, для Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API Key (опционально, для TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ====== БАЗА ДАННЫХ ======
# PostgreSQL настройки
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DSN=postgresql://sovani:your_strong_postgres_password_here@localhost:5432/sovani_ai_seller

# ====== REDIS ======
# Redis настройки для кэширования и сессий
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_ADDR=redis://localhost:6379/0

# ====== WEBHOOK ======
# Настройки Telegram webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET_PATH=your_secret_webhook_path_here

# ====== CRM ИНТЕГРАЦИЯ ======
# AmoCRM настройки
AMOCRM_DOMAIN=your-domain.amocrm.ru
AMOCRM_API_TOKEN=your_amocrm_token_here
AMOCRM_USER_HASH=your_amocrm_user_hash_here

# CRM Retry настройки
CRM_MAX_RETRIES=3
CRM_RETRY_DELAY=1.0

# ====== RATE LIMITING ======
# Настройки ограничения частоты запросов
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW=60

# ====== IDEMPOTENCY ======
# Настройки идемпотентности
IDEMPOTENCY_TTL=3600
SESSION_TTL_SEC=3600

# ====== INPUT SANITIZER ======
# Настройки санитизации ввода
MAX_INPUT_CHARS=2000
SANITIZER_NORMALIZE_UNICODE=true
SANITIZER_XSS_PROTECTION=true

# ====== METRICS И МОНИТОРИНГ ======
# Базовая аутентификация для метрик
METRICS_BASIC_AUTH=your_base64_encoded_credentials

# Уровень логирования
LOG_LEVEL=INFO

# ====== LLM НАСТРОЙКИ ======
# Настройки языковых моделей
LLM_DEFAULT_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# Настройки кэширования LLM
LLM_CACHE_TTL=3600
LLM_CACHE_ENABLED=true

# ====== МОНИТОРИНГ ======
# Grafana настройки
GRAFANA_PASSWORD=your_strong_grafana_password_here

# ====== ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ======
# Настройки производительности
WORKERS_COUNT=1
MAX_CONNECTIONS=100
KEEP_ALIVE_TIMEOUT=5

# Настройки безопасности
CORS_ORIGINS=*
TRUSTED_HOSTS=localhost,127.0.0.1

# Настройки файлов
MAX_FILE_SIZE_MB=10
TEMP_DIR=/tmp/sovani_temp

# ====== DEVELOPMENT НАСТРОЙКИ ======
# Только для разработки
DEBUG=false
RELOAD=false
ACCESS_LOG=true